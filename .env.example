# iRents Site Machine - Environment Variables

# Backend API authentication key (used by frontend to call backend)
APP_API_KEY=changeme-replace-with-secure-key

# OpenAI API key for content generation
OPENAI_API_KEY=sk-...

# Set to true to generate DALL-E 3 images for each page (costs money, slow)
# Leave false while testing — images can always be added later
GENERATE_IMAGES=false

# Database path (SQLite)
DB_PATH=./irents.db

# Server port
PORT=4000

# Frontend settings (copied to app/.env.local by install.bat)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_API_KEY=changeme-replace-with-secure-key
